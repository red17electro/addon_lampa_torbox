{
  "name": "addon_lampa_torbox",
  "private": true,
  "version": "51.2.14",
  "description": "TorBox plugin for Lampa",
  "scripts": {
    "build": "npm run build:legacy",
    "build:legacy": "node scripts/build-legacy.js",
    "check:legacy": "node scripts/build-legacy.js --check",
    "validate": "node scripts/validate.js && npm run check:legacy",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test --project=chromium --reporter=line",
    "test": "npm run validate && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "acorn": "8.15.0",
    "esbuild": "0.25.12"
  }
}
